    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const crypto = require('crypto');\n// Store this in n8n credentials or Settings > Environment Variables — never hardcode it\nconst secret = \"sk_live_c4c7664042cea2f7b46d84957107f48e9a4d2e3e\";\n// Requires \"Raw Body\" enabled in the Webhook node's Options (already set above).\n// With raw body on, n8n gives you the unparsed string in json.body instead of a parsed object.\nconst rawBody = $input.item.json.body;\nconst signature = $input.item.json.headers['x-paystack-signature'];\nif (!secret) {\n  return [{ json: { verified: false, reason: 'missing_secret' } }];\n}\nif (!rawBody || !signature) {\n  return [{ json: { verified: false, reason: 'missing_body_or_signature' } }];\n}\nconst expectedHash = crypto\n  .createHmac('sha512', secret)\n  .update(rawBody)\n  .digest('hex');\nconst isValidSignature = expectedHash === signature;\nlet payload;\ntry {\n  payload = JSON.parse(rawBody);\n} catch (e) {\n  return [{ json: { verified: false, reason: 'invalid_json' } }];\n}\nconst isChargeSuccess = payload.event === 'charge.success';\n// Set the expected price in kobo (NGN smallest unit). e.g. ₦50,000 = 5000000 but 500 is used to test response\nconst expectedAmount = 500;\nconst isAmountCorrect = payload.data && payload.data.amount === expectedAmount;\nreturn [{\n  json: {\n    verified: isValidSignature && isChargeSuccess && isAmountCorrect,\n    reference: payload.data ? payload.data.reference : null,\n    email: payload.data && payload.data.customer ? payload.data.customer.email : null,\n    amount: payload.data ? payload.data.amount : null,\n    reason: !isValidSignature ? 'bad_signature' : !isChargeSuccess ? 'wrong_event' : !isAmountCorrect ? 'amount_mismatch' : 'ok'\n  }\n}];"
      },
